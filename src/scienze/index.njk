<section class="page-head"><a class="back" href="/">← Torna alla Home</a><h1>🔬 Scienze</h1><p>Esperimenti, osservazioni, natura e curiosità per capire meglio il mondo.</p></section>
<div class="cards">
{% for post in collections.scienze %}
<article class="card"><span class="tag">Scienze</span><h3>{{ post.data.title }}</h3><p class="meta">{{ post.data.classe }} · {{ post.data.data }}</p><p>{{ post.data.descrizione }}</p><a class="btn" href="{{ post.url }}">Apri attività</a></article>
{% else %}<div class="empty-state">Non ci sono ancora attività pubblicate in Scienze.</div>{% endfor %}
</div>
